# ==============================================================================
# MZEVOLVE Official Website — Environment Variables Configuration Template
# NOTE: Never commit sensitive production credentials or secret keys to version control.
# ==============================================================================

# Primary Canonical Website URL (leave configurable for staging or production domains)
NEXT_PUBLIC_SITE_URL=https://mzevolve.com

# Verified Official Corporate Contact Channels
NEXT_PUBLIC_CONTACT_EMAIL=mzevolve2026@gmail.com
NEXT_PUBLIC_INQUIRIES_EMAIL=mzevolve2026@gmail.com

# Production Transactional Email Dispatch Provider (Resend)
# Required for contact form email delivery to mzevolve2026@gmail.com.
# Create this secret in Resend and add it to Vercel; do not use a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
# Use a sender address authorized by Resend (verify your sending domain first).
RESEND_FROM_EMAIL=

# Recommended for production on Vercel: shared rate limiting across serverless instances.
# Without these variables, the API uses best-effort per-instance in-memory limiting only.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
